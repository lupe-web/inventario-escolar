import os

class Producto:
    def __init__(self, nombre, precio, cantidad):
        self.nombre = nombre
        self.precio = precio
        self.cantidad = cantidad
        # Calcula el total automáticamente al registrar el producto
        self.total = precio * cantidad

class InventarioEscolar:
    def __init__(self):
        self.productos = []

    def registrar_producto(self):
        print("\n--- REGISTRAR NUEVO PRODUCTO ---")
        nombre = input("Nombre del producto (ej. Mouse, Teclado, Monitor): ").strip()
        
        # Validaciones simples para evitar errores de escritura
        try:
            precio = float(input(f"Precio de {nombre}: $"))
            cantidad = int(input(f"Cantidad a comprar de {nombre}: "))
            
            if precio < 0 or cantidad < 0:
                print(" El precio y la cantidad no pueden ser negativos.")
                return

            # Crear el producto y agregarlo a la lista
            nuevo_producto = Producto(nombre, precio, cantidad)
            self.productos.append(nuevo_producto)
            print(f" ¡{nombre} registrado con éxito!")
            
        except ValueError:
            print(" Error: Por favor ingresa valores numéricos válidos para precio y cantidad.")

    def mostrar_inventario(self):
        print("\n==========================================================")
        print("                INVENTARIO ESCOLAR ACTUAL                 ")
        print("==========================================================")
        
        if not self.productos:
            print("El inventario está vacío actualmente.")
            print("==========================================================")
            return

        # Cabecera de la tabla
        print(f"{'Producto':<20} | {'Precio':<10} | {'Cantidad':<10} | {'Total':<10}")
        print("-" * 58)

        gran_total = 0
        # Mostrar cada producto con formato alineado
        for p in self.productos:
            print(f"{p.nombre:<20} | ${p.precio:<9.2f} | {p.cantidad:<10} | ${p.total:<9.2f}")
            gran_total += p.total

        print("-" * 58)
        print(f"{'VALOR TOTAL DEL INVENTARIO:':<45} ${gran_total:.2f}")
        print("==========================================================")

def menu_principal():
    inventario = InventarioEscolar()

    while True:
        print("\n --- SISTEMA DE INVENTARIO ESCOLAR --- ")
        print("1. Registrar Producto")
        print("2. Mostrar Inventario")
        print("3. Salir")
        
        opcion = input("Selecciona una opción (1-3): ").strip()

        if opcion == "1":
            inventario.registrar_producto()
        elif opcion == "2":
            inventario.mostrar_inventario()
        elif opcion == "3":
            print("\n¡Gracias por usar el sistema de inventario escolar! ¡Hasta luego!")
            break
        else:
            print(" Opción no válida. Por favor, elige entre 1, 2 o 3.")
            
        # Pequeña pausa para que el usuario pueda leer antes de limpiar la terminal (opcional)
        input("\nPresiona Enter para continuar...")
        # Limpia la terminal según el sistema operativo para mantener el orden
        os.system('cls' if os.name == 'nt' else 'clear')

if __name__ == "__main__":
    menu_principal()